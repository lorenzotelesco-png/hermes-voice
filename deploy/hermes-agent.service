[Unit]
Description=Hermes Agent Gateway (port 8642)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/.hermes/hermes-agent
EnvironmentFile=-/root/.hermes/.env
ExecStart=/root/.hermes/hermes-agent/.venv/bin/hermes gateway
Restart=always
RestartSec=5
StartLimitBurst=5
SyslogIdentifier=hermes-agent

[Install]
WantedBy=multi-user.target
