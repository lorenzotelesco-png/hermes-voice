# ── Access control ────────────────────────────────────────────────
# REQUIRED. Without it the server refuses every request with 503, on purpose:
# this URL is public, and the agent behind it can search the web, read memory
# and spend API credits. An open URL is an open agent.
#   openssl rand -hex 32
# Open the app once as https://your-url/?k=<token>; a signed cookie then keeps
# the session for a year, so the token need not stay in the home-screen URL.
VOICE_AUTH_TOKEN=

# ── Hermes Dashboard (speech in/out) ──────────────────────────────
# STT and TTS are served by the Hermes dashboard, not by this server. Which
# providers, models and language get used is configured in ~/.hermes/config.yaml
# under stt.* and tts.* — nothing here.
HERMES_DASHBOARD_URL=http://127.0.0.1:9119

# REQUIRED. Must equal HERMES_DASHBOARD_SESSION_TOKEN in the dashboard's
# environment. If that variable is unset the dashboard generates a random token
# at every start, and these calls will 401 after each restart.
HERMES_DASHBOARD_TOKEN=

# ── Hermes Agent API ──────────────────────────────────────────────
# The Hermes API server: sessions, turns, approvals. Only the origin is used,
# so an older full .../v1/chat/completions URL works too.
HERMES_API_URL=http://127.0.0.1:8642

# REQUIRED. Bearer token for the Hermes API server. Must be identical to
# API_SERVER_KEY in ~/.hermes/.env — Hermes requires it on every deployment,
# including loopback, and returns 401 without it.
HERMES_API_KEY=

# ── Server tab (phase 2) ──────────────────────────────────────────
# Services shown and watched for alerts, and which of them get a restart
# button. The root-side helper (deploy/control/) keeps its own allowlist.
# HUB_SERVICES=hermes-agent,hermes-dashboard,hermes-hub,ngrok-tunnel,hermes-webui,tailscaled,warp-svc,warp-socks-ts
# HUB_RESTARTABLE=hermes-agent,hermes-dashboard,hermes-webui,ngrok-tunnel,warp-svc,warp-socks-ts

# ── Hub ───────────────────────────────────────────────────────────
# SQLite file for the audit log. The systemd unit sets it to
# /var/lib/hermes-hub/hub.db; leave it unset for local development.
# HUB_DB=
